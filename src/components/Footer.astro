---
// src/components/Footer.astro
import SocialIcons from './SocialIcons.astro';
---
<footer class="border-t border-neutral-200 py-10 dark:border-neutral-800">
  <div class="mx-auto flex max-w-4xl flex-col items-center gap-6 px-4">
    <div class="flex items-center gap-6">
      <a href="/" class="font-serif text-xl font-bold text-neutral-900 dark:text-white">Análisis</a>
      <SocialIcons />
    </div>
    <div class="flex flex-wrap items-center justify-center gap-4 text-sm text-neutral-500 dark:text-neutral-400">
      <a href="/sobre" class="hover:text-amber-600 dark:hover:text-amber-400">Sobre el proyecto</a>
      <a href="/contacto" class="hover:text-amber-600 dark:hover:text-amber-400">Contacto</a>
      <a href="/admin/comentarios" class="hover:text-amber-600 dark:hover:text-amber-400">Moderación</a>
    </div>
    <p class="text-xs text-neutral-400 dark:text-neutral-500">© 2026 Análisis · analisis.pruebapublica.com</p>
  </div>
