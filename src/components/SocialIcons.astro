---
// src/components/SocialIcons.astro
const socials = [
  { name: 'X', url: 'https://x.com/pruebapublicaX', icon: 'X' },
  { name: 'Bluesky', url: 'https://bsky.app/profile/pruebapublica.bsky.social', icon: 'B' },
  {
    name: 'Mastodon',
    url: 'https://mastodon.social/@PruebaPublica',
    svg: '<svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true"><path d="M18.64 1.91H5.36c-1.43 0-2.59 1.16-2.59 2.59v13.18c0 1.19.87 2.2 2.04 2.39l.55.09a1.6 1.6 0 0 0 2.25-1.52v-1.7a1.6 1.6 0 0 1 1.32-1.58c2.27-.3 4.89-.3 7.16 0a1.6 1.6 0 0 1 1.32 1.58v1.7a1.6 1.6 0 0 0 2.25 1.52l.55-.09a2.42 2.42 0 0 0 2.04-2.39V4.5c0-1.43-1.16-2.59-2.59-2.59ZM6.87 13.4c-1.16 0-2.03-.53-2.46-1.5-.37-.82.27-1.73 1.16-1.73.8 0 1.35.43 1.61 1.1.5 1.27 1.86 1.82 3.21 1.82 1.35 0 2.71-.55 3.21-1.82.26-.67.81-1.1 1.61-1.1.89 0 1.53.9 1.16 1.73-.43.97-1.3 1.5-2.46 1.5-.57 0-1.09-.1-1.5-.28.32.79.99 1.32 1.79 1.5l-.03 2.02c0 .58-.47 1.05-1.05 1.05-.6 0-1.05-.47-1.05-1.05v-2.06c-.55.02-1.13.03-1.73.03s-1.18-.01-1.73-.03v2.06c0 .58-.45 1.05-1.05 1.05a1.05 1.05 0 0 1-1.05-1.05v-2.02c.8-.18 1.47-.7 1.79-1.5-.4.18-.92.28-1.49.28Z"/></svg>',
  },
];
---
<div class="flex items-center gap-3">
  {socials.map((s) => (
    <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={s.name}
       class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-slate-300 text-sm font-bold text-slate-600 transition hover:border-accent-600 hover:text-accent-700 dark:border-slate-700 dark:text-slate-300 dark:hover:border-accent-400 dark:hover:text-accent-400">
      {s.svg ? <span set:html={s.svg} class="flex" /> : s.icon}
    </a>
  ))}
</div>