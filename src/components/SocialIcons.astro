---
// src/components/SocialIcons.astro
// Mastodon: pendiente de cuenta — se muestra pero sin enlace hasta definir el handle.
const socials = [
  { name: 'X', url: 'https://x.com/pruebapublicaX', icon: 'X' },
  { name: 'Bluesky', url: 'https://bsky.app/profile/pruebapublica.bsky.social', icon: 'B' },
];
---
<div class="flex items-center gap-3">
  {socials.map((s) => (
    <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={s.name}
       class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-slate-300 text-sm font-bold text-slate-600 transition hover:border-accent-600 hover:text-accent-700 dark:border-slate-700 dark:text-slate-300 dark:hover:border-accent-400 dark:hover:text-accent-400">
      {s.icon}
    </a>
  ))}
</div>

