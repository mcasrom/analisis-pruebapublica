---
// src/components/SocialIcons.astro
const socials = [
  { name: 'Mastodon', url: 'https://mastodon.social/@pruebapolitica', icon: 'M' },
  { name: 'Bluesky', url: 'https://bsky.app/profile/pruebapolitica', icon: 'B' },
  { name: 'X', url: 'https://x.com/pruebapoliticaX', icon: 'X' },
];
---
<div class="flex items-center gap-3">
  {socials.map((s) => (
    <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={s.name}
       class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-neutral-300 text-sm font-bold text-neutral-600 transition hover:border-amber-600 hover:text-amber-700 dark:border-neutral-700 dark:text-neutral-300 dark:hover:border-amber-400 dark:hover:text-amber-400">
      {s.icon}
    </a>
  ))}
</div>
