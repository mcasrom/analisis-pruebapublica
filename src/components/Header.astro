---
// src/components/Header.astro
import SocialIcons from './SocialIcons.astro';
import ThemeToggle from './ThemeToggle.astro';
const nav = [
  { href: '/', label: 'Inicio' },
  { href: '/categorias', label: 'Categorías' },
  { href: '/sobre', label: 'Sobre el proyecto' },
  { href: '/contacto', label: 'Contacto' },
];
---
<header class="border-b border-slate-200 dark:border-slate-800">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-6">
    <a href="/" class="flex flex-col leading-none">
      <span class="font-serif text-4xl font-bold tracking-tight text-slate-900 dark:text-white">Análisis</span>
      <span class="mt-1 text-sm text-slate-500 dark:text-slate-400">Geopolítica y análisis crítico del poder</span>
    </a>
    <nav class="flex items-center gap-6">
      {nav.map((n) => (
        <a href={n.href} class="hidden text-sm text-slate-600 transition hover:text-accent-600 dark:text-slate-300 dark:hover:text-accent-400 sm:block">
          {n.label}
        </a>
      ))}
      <ThemeToggle />
      <SocialIcons />
    </nav>
  </div>
</header>
