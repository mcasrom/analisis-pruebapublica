---
// src/pages/correcciones.astro
import Layout from '../layouts/Layout.astro';

const correcciones = [
  {
    fecha: '2026-10-17',
    area: 'Series',
    que: 'Las descripciones decían «Tres/Seis fábulas» y «siete entregas» de Ceuta; Dereliction se atribuía a «Reino Unido y España» y tres posts hablaban de «Geopolítica 2026».',
    ahora: 'Unificado a «Siete fábulas», «seis entregas», «en España» y «Geopolítica 101».',
  },
  {
    fecha: '2026-10-17',
    area: 'Fuentes',
    que: 'El post del presupuesto europeo afirmaba «Fuentes enlazadas en el texto», pero El País y Reuters no tenían URL.',
    ahora: 'Retirada la afirmación; se indica que los documentos oficiales (Comisión y Consejo) son la referencia primaria.',
  },
  {
    fecha: '2026-10-17',
    area: 'Newsletter',
    que: 'Coexistían tres promesas distintas: «un correo al mes», «cada artículo nuevo» y «resumen semanal».',
    ahora: 'Una sola: «un correo al mes con los análisis clave».',
  },
  {
    fecha: '2026-10-16',
    area: 'Publicación',
    que: 'El post «El consejo del bosque y la bolsa vacía» se publicó sin cuerpo por un fallo en la subida del fichero.',
    ahora: 'Cuerpo completo restaurado el mismo día, con su imagen OG.',
  },
  {
    fecha: '2026-10-16',
    area: 'Enlaces',
    que: 'Un post enlazaba a /metodo.html, inexistente en el blog.',
    ahora: 'Enlace corregido a la página de método del observatorio.',
  },
];
---
<Layout
  title="Correcciones"
  description="Registro público de errores corregidos en el blog: qué se dijo, qué se corrigió y cuándo."
  url="/correcciones/"
>
  <h1 class="font-serif text-4xl font-bold text-slate-900 dark:text-white">Correcciones</h1>
  <p class="mt-3 max-w-2xl text-lg text-slate-600 dark:text-slate-400">
    Registro público de errores corregidos. Si detectas uno, escribe a
    <a href="mailto:analisis@pruebapublica.com">analisis@pruebapublica.com</a>.
  </p>

  <ul class="mt-8 space-y-6">
    {correcciones.map((c) => (
      <li class="rounded-2xl border border-slate-200 p-5 dark:border-slate-800">
        <div class="flex flex-wrap items-baseline gap-3">
          <time class="text-sm font-semibold text-slate-500 dark:text-slate-400" datetime={c.fecha}>{c.fecha}</time>
          <span class="rounded-full bg-slate-100 px-3 py-0.5 text-xs font-semibold uppercase tracking-widest text-slate-600 dark:bg-slate-800 dark:text-slate-300">{c.area}</span>
        </div>
        <p class="mt-3 text-sm text-slate-700 dark:text-slate-300"><strong>Qué se dijo:</strong> {c.que}</p>
        <p class="mt-1 text-sm text-slate-700 dark:text-slate-300"><strong>Qué se corrigió:</strong> {c.ahora}</p>
      </li>
    ))}
  </ul>

  <div class="prose-editorial mt-10">
    <h2>Política de correcciones</h2>
    <p>
      Un error se corrige cuando se detecta, con independencia de quién lo señale. La corrección se
      anota aquí con fecha y con el cambio exacto; no se reescribe el pasado en silencio. Cuando un
      dato depende de una fuente externa, se indica la fecha de corte.
    </p>
    <p>
      El <strong>radar</strong> tiene además su propio registro metodológico:
      <a href="/radar-changelog/">changelog del radar</a>.
    </p>
  </div>
</Layout>
