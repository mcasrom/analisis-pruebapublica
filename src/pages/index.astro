---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getLikes } from '../lib/db';

const posts = (await getCollection('posts')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const destacado = posts[0];
const fmt = new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Layout title="Inicio" url="/">
  <!-- Hero -->
  <section class="py-14 text-center">
    <h1 class="font-serif text-5xl font-bold tracking-tight text-neutral-900 dark:text-white">
      Análisis
    </h1>
    <p class="mx-auto mt-4 max-w-xl text-lg text-neutral-600 dark:text-neutral-300">
      Geopolítica y análisis político. Contexto, datos y lectura crítica de la actualidad.
    </p>
  </section>

  {destacado && (
    <section class="mb-12">
      <span class="text-xs font-semibold uppercase tracking-widest text-amber-600 dark:text-amber-400">Destacado</span>
      <a href={`/posts/${destacado.slug}`} class="mt-2 block">
        <h2 class="font-serif text-3xl font-bold leading-tight text-neutral-900 transition hover:text-amber-700 dark:text-white dark:hover:text-amber-400">
          {destacado.data.title}
        </h2>
        <p class="mt-2 text-neutral-600 dark:text-neutral-300">{destacado.data.description}</p>
        <span class="mt-3 inline-block text-sm text-neutral-500">
          {fmt.format(destacado.data.pubDate)} · {destacado.data.categoria} · ♥ {getLikes(destacado.slug)}
        </span>
      </a>
    </section>
  )}

  <section>
    <h2 class="mb-6 border-b border-neutral-200 pb-2 font-serif text-2xl font-bold text-neutral-900 dark:border-neutral-800 dark:text-white">
      Artículos
    </h2>
    <ul class="divide-y divide-neutral-200 dark:divide-neutral-800">
      {posts.map((post) => (
        <li class="py-6">
          <a href={`/posts/${post.slug}`} class="group block">
            <span class="text-sm text-neutral-500">{fmt.format(post.data.pubDate)} · {post.data.categoria}</span>
            <h3 class="mt-1 font-serif text-2xl font-bold text-neutral-900 transition group-hover:text-amber-700 dark:text-white dark:group-hover:text-amber-400">
              {post.data.title}
            </h3>
            <p class="mt-1 text-neutral-600 dark:text-neutral-300">{post.data.description}</p>
            {post.data.tags.length > 0 && (
              <div class="mt-2 flex flex-wrap gap-2">
                {post.data.tags.map((tag) => (
                  <span class="rounded-full bg-neutral-100 px-3 py-1 text-xs text-neutral-600 dark:bg-neutral-800 dark:text-neutral-300">#{tag}</span>
                ))}
              </div>
            )}
          </a>
        </li>
      ))}
    </ul>
  </section>
</Layout>
